# Local backend environment
# Copy this file to .env for local development.

PORT=3001
NODE_ENV=development
ENVIRONMENT=local
LOG_FORMAT=pino-pretty
AGGREGATOR_BASE_URL=http://localhost:3002
AGGREGATOR_STATUS_TIMEOUT_MS=3000

# Optional in local development. In non-local environments set via CDP Secrets.
AGGREGATOR_HEARTBEAT_AUTH_TOKEN=

# Local Postgres (docker compose postgres service)
POSTGRES_ENABLED=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=water_availability
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_ENABLED=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false
